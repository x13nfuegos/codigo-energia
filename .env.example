# ---- Obligatorias en producción ----
# Clave del back office (/admin)
ADMIN_PASSWORD=cambiar-esto
# Secreto para firmar la cookie de sesión y proteger los cron (/api/cron/*)
ADMIN_SECRET=una-cadena-larga-y-aleatoria
CRON_SECRET=otra-cadena-larga-y-aleatoria

# URL pública del sitio (para sitemap, links absolutos)
NEXT_PUBLIC_SITE_URL=https://codigoenergia.ar

# ---- Base de datos (Supabase) ----
# Si no se definen, el sitio usa un archivo local .data/db.json (solo para desarrollo).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket público de Storage donde se guardan audios/videos del resumen
SUPABASE_MEDIA_BUCKET=media

# ---- IA ----
# Resumen de cada nota: IA económica. Con GEMINI_API_KEY usa Gemini Flash (tiene capa gratuita);
# si no, con ANTHROPIC_API_KEY usa Claude Haiku 4.5. Sin ninguna, se muestra un extracto de la nota original.
GEMINI_API_KEY=
# Opcional: forzar proveedor (gemini | anthropic) y modelo para los resúmenes
AI_PROVIDER=
AI_MODEL=
# Resumen diario (una vez por día)
ANTHROPIC_API_KEY=

# ---- Audio del resumen (ElevenLabs) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- Video del resumen (HeyGen) ----
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# ---- Mapa (opcional) ----
# Token público de Mapbox para un mapa base más prolijo. Sin token se usa CARTO/OpenStreetMap.
NEXT_PUBLIC_MAPBOX_TOKEN=
